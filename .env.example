# Root env — infrastructure + shared backend (server-only).
# Per-app values (BETTER_AUTH_URL / NEXT_PUBLIC_APP_NAME / ...) live in apps/<app>/.env.
# Copy this file to `.env` for local development.

# --- Docker (consumed by docker-compose.yml) ---
POSTGRES_DB=cloud_frontend
POSTGRES_USER=cloud
POSTGRES_PASSWORD=cloud_dev_password
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- Shared backend connections ---
DATABASE_URL=postgresql://cloud:cloud_dev_password@localhost:5433/cloud_frontend?schema=public
REDIS_URL=redis://localhost:6379

# --- Shared secrets ---
# 生成方式：`npx @better-auth/cli@latest secret`
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Shared backend tunables ---
SESSION_COOKIE_NAME=session-token
SESSION_CACHE_PREFIX=session:
SESSION_TTL_SECONDS=86400
REQUEST_BODY_LIMIT_BYTES=10485760
