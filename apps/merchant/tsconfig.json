{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/utils": ["../../packages/ui/src/lib/utils"],
      "@/lib/theme": ["../../packages/ui/src/lib/theme"],
      "@/components/ui/*": ["../../packages/ui/src/components/ui/*"],
      "@/*": ["./*"],
      "@cloud/ui": ["../../packages/ui/src/index.ts"],
      "@cloud/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
