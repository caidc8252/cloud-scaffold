# Partner app env. Copy to `apps/partner/.env`.
# Shared backend secrets live in the root .env — do not duplicate them here.

BETTER_AUTH_URL=http://localhost:3000
# 逗号分隔，支持通配符（例如 *.example.com 或 *）。
# 本地开发可留空：NODE_ENV != production 时 dev 模式自动放行所有 origin。
# 生产 / PaaS 部署优先读取 Render / Docker 注入的同名环境变量，文件值仅作 fallback。
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cloud Partner
