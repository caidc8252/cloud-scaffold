{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@cloud/auth": ["./packages/auth/src/index.ts"],
      "@cloud/cache": ["./packages/cache/src/index.ts"],
      "@cloud/config": ["./packages/config/src/index.ts"],
      "@cloud/db": ["./packages/db/src/index.ts"],
      "@cloud/i18n": ["./packages/i18n/src/index.ts"],
      "@cloud/i18n/server": ["./packages/i18n/src/server.ts"],
      "@cloud/i18n/client": ["./packages/i18n/src/client.tsx"],
      "@cloud/permissions": ["./packages/permissions/src/index.ts"],
      "@cloud/request": ["./packages/request/src/index.ts"],
      "@cloud/security/client": ["./packages/security/src/client/index.ts"],
      "@cloud/security/server": ["./packages/security/src/server/index.ts"],
      "@cloud/ui": ["./packages/ui/src/index.ts"],
      "@cloud/ui/*": ["./packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
